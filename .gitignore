# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
Arkanoid_Game/.utmp/
Arkanoid_Game/[Ll]ibrary/
Arkanoid_Game/[Tt]emp/
Arkanoid_Game/[Oo]bj/
Arkanoid_Game/[Bb]uild/
Arkanoid_Game/[Bb]uilds/
Arkanoid_Game/[Ll]ogs/
Arkanoid_Game/[Uu]ser[Ss]ettings/
Arkanoid_Game/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
Arkanoid_Game/*.blend1
Arkanoid_Game/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
Arkanoid_Game/[Mm]emoryCaptures/

# Recordings can get excessive in size
Arkanoid_Game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
Arkanoid_Game/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
Arkanoid_Game/*.DotSettings.user

# Visual Studio cache directory
Arkanoid_Game/.vs/

# Gradle cache directory
Arkanoid_Game/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
Arkanoid_Game/ExportedObj/
Arkanoid_Game/.consulo/
Arkanoid_Game/*.csproj
Arkanoid_Game/*.unityproj
Arkanoid_Game/*.sln
Arkanoid_Game/*.slnx
Arkanoid_Game/*.suo
Arkanoid_Game/*.tmp
Arkanoid_Game/*.user
Arkanoid_Game/*.userprefs
Arkanoid_Game/*.pidb
Arkanoid_Game/*.booproj
Arkanoid_Game/*.svd
Arkanoid_Game/*.pdb
Arkanoid_Game/*.mdb
Arkanoid_Game/*.opendb
Arkanoid_Game/*.VC.db

# Unity3D generated meta files
Arkanoid_Game/*.pidb.meta
Arkanoid_Game/*.pdb.meta
Arkanoid_Game/*.mdb.meta

# Unity3D generated file on crash reports
Arkanoid_Game/sysinfo.txt

# Mono auto generated files
Arkanoid_Game/mono_crash.*

# Builds
Arkanoid_Game/*.apk
Arkanoid_Game/*.aab
Arkanoid_Game/*.unitypackage
Arkanoid_Game/*.unitypackage.meta
Arkanoid_Game/*.app

# Crashlytics generated file
Arkanoid_Game/crashlytics-build.properties

# TestRunner generated files
Arkanoid_Game/InitTestScene*.unity*

# Addressables default ignores, before user customizations
Arkanoid_Game/ServerData
Arkanoid_Game/[Aa]ssets/StreamingAssets/aa*
Arkanoid_Game/[Aa]ssets/AddressableAssetsData/link.xml*
Arkanoid_Game/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
Arkanoid_Game/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
Arkanoid_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
Arkanoid_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
Arkanoid_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
Arkanoid_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
Arkanoid_Game/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
Arkanoid_Game/[Aa]ssets/[Ss]ceneDependencyCache*

# Claude Code 지침 및 개발용 참고문서 (비공개)
/CLAUDE.md
/_Docs/
.claude/


content.png